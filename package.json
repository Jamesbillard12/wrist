{
  "name": "wrist-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental TSX-to-SwiftUI compiler for watchOS",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wrist": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "compile:example": "npm run build && node dist/src/cli.js examples/hello.tsx --out generated/Hello.swift"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
